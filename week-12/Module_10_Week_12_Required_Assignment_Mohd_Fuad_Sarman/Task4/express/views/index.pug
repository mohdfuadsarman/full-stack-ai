doctype html
html
  head
    title= title
    - var petList = Array.isArray(pets) ? pets : (pets ? [pets] : []);
    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Segoe UI', sans-serif;
        background: #f0f4f8;
        color: #2d3748;
        padding: 2rem;
      }
      h1 {
        text-align: center;
        font-size: 2.5rem;
        color: #2b6cb0;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        text-align: center;
        color: #718096;
        margin-bottom: 2rem;
      }
      .container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: auto;
      }
      .card {
        background: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s;
      }
      .card:hover {
        transform: translateY(-4px);
      }
      .card h2 {
        margin-bottom: 1rem;
        color: #2d3748;
        font-size: 1.25rem;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      input, button {
        padding: 0.75rem;
        border-radius: 10px;
        border: 1px solid #cbd5e0;
        font-size: 1rem;
        transition: 0.2s;
      }
      input:focus {
        border-color: #4299e1;
        outline: none;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
      }
      button {
        background: #2b6cb0;
        color: white;
        border: none;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover {
        background: #2c5282;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
      }
      th, td {
        padding: 1rem;
        border-bottom: 1px solid #edf2f7;
        text-align: left;
      }
      th {
        background: #ebf4ff;
        color: #2a4365;
      }
      tr:hover {
        background: #f7fafc;
      }
      p {
        font-style: italic;
        color: #718096;
      }

  body
    h1 🐾 Pet Database
    p.subtitle Manage your pets with ease!

    .container
      .card
        h2 📋 View All Pets
        form(action='/', method='GET')
          button(type='submit') Load Pets

      .card
        h2 🧹 Clear All Pets
        form(action='/clear', method='POST')
          button(type='submit') Clear All

      .card
        h2 🔄 Reset Database
        form(action='/reset', method='POST')
          button(type='submit') Reset

      if petList && petList.length > 0
        .card(style="grid-column: 1 / -1")
          h2 🐶 Pet List
          table
            thead
              tr
                th ID
                th Name
                th Type
                th Age
                th Owner
            tbody
              each pet in petList
                tr
                  td= pet.id
                  td= pet.name
                  td= pet.type
                  td= pet.age
                  td= pet.owner
      else
        .card(style="grid-column: 1 / -1")
          p No pets found.

      .card
        h2 ➕ Add Pet
        form(action='/create', method='POST')
          input(type='text', name='name', placeholder='Name', required)
          input(type='text', name='type', placeholder='Type', required)
          input(type='number', name='age', placeholder='Age', required)
          input(type='text', name='owner', placeholder='Owner', required)
          button(type='submit') Add Pet

      .card
        h2 🔍 Find by ID
        form(method='GET' onsubmit="this.action='/pets/' + this.id.value")
          input(type='text', name='id', placeholder='Pet ID', required)
          button(type='submit') Find

      .card
        h2 🔍 Find by Name
        form(method='GET' onsubmit="this.action='/pets/name/' + this.name.value")
          input(type='text', name='name', placeholder='Pet Name', required)
          button(type='submit') Find

      .card
        h2 🔍 Find by Type
        form(method='GET' onsubmit="this.action='/pets/type/' + this.type.value")
          input(type='text', name='type', placeholder='Pet Type', required)
          button(type='submit') Find

      .card
        h2 🔍 Find by Owner
        form(method='GET' onsubmit="this.action='/pets/owner/' + this.owner.value")
          input(type='text', name='owner', placeholder='Owner', required)
          button(type='submit') Find

      .card
        h2 🔍 Find by Age Range
        form(action='/pets/age/age', method='GET')
          input(type='number', name='minAge', placeholder='Min Age', required)
          input(type='number', name='maxAge', placeholder='Max Age', required)
          button(type='submit') Find

      .card
        h2 ✏️ Update Pet
        form(method='POST' onsubmit="this.action='/update/' + this.petId.value")
          input(type='text', name='petId', placeholder='Pet ID', required)
          input(type='text', name='name', placeholder='New Name')
          input(type='text', name='type', placeholder='New Type')
          input(type='number', name='age', placeholder='New Age')
          input(type='text', name='owner', placeholder='New Owner')
          button(type='submit') Update

      .card
        h2 ❌ Delete Pet
        form(method='POST' onsubmit="this.action='/delete/' + this.petId.value")
          input(type='text', name='petId', placeholder='Pet ID', required)
          button(type='submit') Delete

