		{
			"name": "TestGetAllStudents_404",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const students = [",
							"    { name: \"Alice\", email: \"alice@example.com\", program: \"CS\" },",
							"    { name: \"Bob\", email: \"bob@example.com\", program: \"Math\" },",
							"    { name: \"Charlie\", email: \"charlie@example.com\", program: \"Physics\" }",
							"];",
							"",
							"let insertCount = 0;",
							"",
							"pm.sendRequest({",
							"    url: \"http://localhost:3000/students/reset\",",
							"    method: 'DELETE',",
							"    header: { 'Content-Type': 'application/json' }",
							"}, function (err, res) {",
							"    // Start inserting students only after reset is done",
							"    students.forEach((student) => {",
							"        pm.sendRequest({",
							"            url: \"http://localhost:3000/students\",",
							"            method: 'POST',",
							"            header: { 'Content-Type': 'application/json' },",
							"            body: {",
							"                mode: 'raw',",
							"                raw: JSON.stringify(student)",
							"            }",
							"        }, function (err, res) {",
							"            if (err) {",
							"                console.log(\"Error inserting student:\", err);",
							"            } else {",
							"                console.log(res.text());",
							"            }",
							"",
							"            insertCount++;",
							"            if (insertCount === students.length) {",
							"                console.log(\"All students inserted.\");",
							"            }",
							"        });",
							"    });",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code is 404\", function () {",
							"    pm.expect(pm.response.code).to.equal(404);",
							"});",
							"",
							"pm.test(\"Response is html\", function () {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
