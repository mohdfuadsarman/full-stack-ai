	"item": [
		{
			"name": "TestGetAllStudents_200",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const students = [",
							"    { name: \"Alice\", email: \"alice@example.com\", program: \"CS\" },",
							"    { name: \"Bob\", email: \"bob@example.com\", program: \"Math\" },",
							"    { name: \"Charlie\", email: \"charlie@example.com\", program: \"Physics\" }",
							"];",
							"",
							"let insertCount = 0;",
							"",
							"pm.sendRequest({",
							"    url: \"http://localhost:3000/students/reset\",",
							"    method: 'DELETE',",
							"    header: { 'Content-Type': 'application/json' }",
							"}, function (err, res) {",
							"    // Start inserting students only after reset is done",
							"    students.forEach((student) => {",
							"        pm.sendRequest({",
							"            url: \"http://localhost:3000/students\",",
							"            method: 'POST',",
							"            header: { 'Content-Type': 'application/json' },",
							"            body: {",
							"                mode: 'raw',",
							"                raw: JSON.stringify(student)",
							"            }",
							"        }, function (err, res) {",
							"            if (err) {",
							"                console.log(\"Error inserting student:\", err);",
							"            } else {",
							"                console.log(res.text());",
							"            }",
							"",
							"            insertCount++;",
							"            if (insertCount === students.length) {",
							"                console.log(\"All students inserted.\");",
							"            }",
							"        });",
							"    });",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code is 200\", function () {",
							"    pm.expect(pm.response.code).to.equal(200);",
							"});",
							"",
							"pm.test(\"Response is an array of student objects\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('array').that.is.not.empty;",
							"    responseData.forEach(function(student) {",
							"        pm.expect(student).to.be.an('object');",
							"    });",
							"});",
							"",
							"pm.test(\"Each student object has the required fields\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('array').that.is.not.empty;",
							"",
							"    responseData.forEach(function(student) {",
							"        pm.expect(student).to.have.property('id');",
							"        pm.expect(student).to.have.property('name');",
							"        pm.expect(student).to.have.property('email');",
							"        pm.expect(student).to.have.property('program');",
							"    });",
							"});",
							"",
							"pm.test(\"Each student object has valid data types for each field\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('array');",
							"    responseData.forEach(student => {",
							"        pm.expect(student.id).to.be.a('number').and.to.be.greaterThan(0);",
							"        pm.expect(student.name).to.be.a('string');",
							"        pm.expect(student.email).to.be.a('string');",
							"        pm.expect(student.program).to.be.a('string');",
							"    });",
							"});",
							"",
							"const expectedStudents = [",
							"    { id: 1, name: \"Alice\", email: \"alice@example.com\", program: \"CS\" },",
							"    { id: 2, name: \"Bob\", email: \"bob@example.com\", program: \"Math\" },",
							"    { id: 3, name: \"Charlie\", email: \"charlie@example.com\", program: \"Physics\" }",
							"];",
							"",
							"pm.test(\"All expected students are returned with correct values\", function () {",
							"    const actualStudents = pm.response.json();",
							"",
							"    pm.expect(actualStudents).to.be.an(\"array\");",
							"    pm.expect(actualStudents.length).to.be.at.least(expectedStudents.length);",
							"",
							"    expectedStudents.forEach(expected => {",
							"        const match = actualStudents.find(actual =>",
							"            actual.name === expected.name &&",
							"            actual.email === expected.email &&",
							"            actual.program === expected.program",
							"        );",
							"",
							"        pm.expect(match, `Student ${expected.name} should exist with correct data`).to.not.be.undefined;",
							"    });",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
